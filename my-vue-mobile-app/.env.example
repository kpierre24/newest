# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# App Configuration
VITE_APP_NAME="Cathedral Engage"
VITE_APP_VERSION="1.0.0"

# Feature Flags (true/false)
VITE_ENABLE_DEBUG_LOGGING=false
VITE_ENABLE_MOCK_API=false

# File Upload Configuration
# Maximum file size in bytes (default: 5MB)
VITE_MAX_FILE_SIZE=5242880
# Comma-separated list of allowed MIME types
VITE_ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# Authentication (times in seconds)
VITE_AUTH_TOKEN_EXPIRY=3600
VITE_AUTH_REFRESH_THRESHOLD=300

# Timeouts
# API timeout in milliseconds (default: 30 seconds)
VITE_API_TIMEOUT=30000
# Verification code expiry in seconds (default: 5 minutes)
VITE_VERIFICATION_CODE_EXPIRY=300

# Note: This is an example configuration file.
# Copy this file to .env and update the values according to your environment.
# Do not commit the actual .env file to version control. 