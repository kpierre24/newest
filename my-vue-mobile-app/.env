# API Configuration
VITE_API_BASE_URL=https://engage-api-bmb0fqhpg7bkdwdp.eastus2-01.azurewebsites.net
VITE_API_TIMEOUT=5000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# App Configuration
VITE_APP_NAME="Cathedral Engage"
VITE_APP_VERSION="1.0.0"

# Feature Flags
VITE_ENABLE_DEBUG_LOGGING=true
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_ERROR_TRACKING=true

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880  # 5MB in bytes
VITE_ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"

# Authentication
VITE_AUTH_TOKEN_EXPIRY=3600  # in seconds
VITE_AUTH_REFRESH_THRESHOLD=300  # refresh token 5 minutes before expiry

# Timeouts
VITE_API_TIMEOUT=30000  # API timeout in milliseconds
VITE_VERIFICATION_CODE_EXPIRY=300  # verification code expiry in seconds 

# Error Handling
VITE_ENABLE_ERROR_LOGGING=true
VITE_ERROR_LOG_LEVEL=error
